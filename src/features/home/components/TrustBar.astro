---
const companies = ['Aurora', 'Breeze', 'Vera', 'Nordic', 'Pulse', 'Orbit']
---

<section
  aria-label="Trusted companies"
  class="border-y border-border/50 bg-muted/30 px-4 py-12 md:px-6"
>
  <div class="mx-auto max-w-7xl">
    <p class="text-center text-xs font-medium uppercase tracking-wider text-muted-foreground">
      TRUSTED BY COMPANIES OF ALL SIZES
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 opacity-60">
      {companies.map((company) => (
          <span class="text-lg font-semibold tracking-tight">{company}</span>
        ))}
    </div>
  </div>
</section>
