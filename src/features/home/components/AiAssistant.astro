---
import { Check } from '@mailflow/ui/icons'

import { aiAssistantBenefits } from '../constants/aiAssistantBenefits'
---

<section id="ai-assistant" class="px-4 py-24 md:px-6">
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <figure class="rounded-2xl border border-border/60 bg-card/50 p-6 shadow-xl">
        <figcaption class="sr-only">MailFlow AI assistant preview</figcaption>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="size-10 rounded-full bg-primary/15"></div>
            <div class="flex-1 space-y-1.5">
              <div class="h-3 w-1/3 rounded bg-muted"></div>
              <div class="h-2.5 w-1/2 rounded bg-muted/70"></div>
            </div>
          </div>
          <div class="rounded-xl border border-border/60 bg-background p-4">
            <div class="h-2 w-3/4 rounded bg-muted"></div>
            <div class="mt-2 h-2 w-1/2 rounded bg-muted/60"></div>
          </div>
          <div class="flex gap-2">
            <span
              class="rounded-md bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground transition-colors hover:bg-secondary/80"
            >
              +12% opens
            </span>
            <span
              class="rounded-md bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground transition-colors hover:bg-secondary/80"
            >
              suggested by AI
            </span>
          </div>
        </div>
      </figure>
    </div>

    <div class="order-1 lg:order-2">
      <span
        class="mb-4 inline-flex items-center rounded-full bg-secondary px-3 py-0.5 text-xs font-semibold text-secondary-foreground transition-colors hover:bg-secondary/80"
      >
        Artificial Intelligence
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
        Let AI handle the busywork while you focus on strategy
      </h2>
      <p class="mt-4 text-muted-foreground">
        The MailFlow assistant learns from your account data to suggest better subject lines,
        segment audiences, reply to routine emails, and generate executive reports.
      </p>

      <ul class="mt-6 space-y-3">
        {aiAssistantBenefits.map((benefit) => (
            <li class="flex items-center gap-3 text-sm">
              <div class="flex size-5 items-center justify-center rounded-full bg-primary/15">
                <Check aria-hidden="true" className="size-3 text-primary" />
              </div>
              {benefit}
            </li>
          ))}
      </ul>
    </div>
  </div>
</section>
