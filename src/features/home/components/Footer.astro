---
import { Globe } from '@mailflow/ui/icons'

import { companyText, legalText, productLinks, productText } from '../constants/footerLinks'
import Brand from './Brand'
---

<footer class="border-t border-border/50 px-4 py-12 md:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <Brand />
        <p class="mt-3 text-sm text-muted-foreground">
          The modern email and marketing platform powered by AI.
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-foreground">Product</h4>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          {productLinks.map((link) => (
              <li>
                <a class="transition-colors hover:text-foreground" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          {productText.map((label) => (
              <li>
                <span class="transition-colors hover:text-foreground">{label}</span>
              </li>
            ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-foreground">Company</h4>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          {companyText.map((label) => (
              <li>
                <span class="transition-colors hover:text-foreground">{label}</span>
              </li>
            ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-foreground">Legal</h4>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          {legalText.map((label) => (
              <li>
                <span class="transition-colors hover:text-foreground">{label}</span>
              </li>
            ))}
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border/50 pt-6 text-xs text-muted-foreground sm:flex-row"
    >
      <p>© 2026 MailFlow AI. All rights reserved.</p>
      <span class="flex items-center gap-4">
        <Globe aria-hidden="true" className="size-4" />
        English (United States)
      </span>
    </div>
  </div>
</footer>
