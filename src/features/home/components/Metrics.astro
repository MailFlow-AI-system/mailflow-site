<section id="metrics" class="px-4 py-24 md:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
          Measurable results from day one
        </h2>
        <p class="mt-4 text-muted-foreground">
          Clean dashboards, clear metrics, and smart alerts help you make decisions based on data,
          not assumptions.
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-4">
        <div
          class="flex flex-col-reverse justify-center rounded-xl border border-border/60 bg-card/60 p-5 shadow-sm transition-colors hover:bg-card"
        >
          <dt class="mt-1 text-xs text-muted-foreground">average productivity increase</dt>
          <dd class="text-3xl font-bold text-primary">40%</dd>
        </div>
        <div
          class="flex flex-col-reverse justify-center rounded-xl border border-border/60 bg-card/60 p-5 shadow-sm transition-colors hover:bg-card"
        >
          <dt class="mt-1 text-xs text-muted-foreground">faster campaign creation</dt>
          <dd class="text-3xl font-bold text-primary">3x</dd>
        </div>
        <div
          class="flex flex-col-reverse justify-center rounded-xl border border-border/60 bg-card/60 p-5 shadow-sm transition-colors hover:bg-card"
        >
          <dt class="mt-1 text-xs text-muted-foreground">guaranteed uptime</dt>
          <dd class="text-3xl font-bold text-primary">99.9%</dd>
        </div>
        <div
          class="flex flex-col-reverse justify-center rounded-xl border border-border/60 bg-card/60 p-5 shadow-sm transition-colors hover:bg-card"
        >
          <dt class="mt-1 text-xs text-muted-foreground">companies trust MailFlow</dt>
          <dd class="text-3xl font-bold text-primary">2,500+</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
