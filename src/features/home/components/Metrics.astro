---
import { metrics } from '../constants/metrics'
---

<section id="metrics" class="px-4 py-24 md:px-6">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
          Measurable results from day one
        </h2>
        <p class="mt-4 text-muted-foreground">
          Clean dashboards, clear metrics, and smart alerts help you make decisions based on data,
          not assumptions.
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-4">
        {metrics.map((metric) => (
            <div
              class="flex flex-col-reverse justify-center rounded-xl border border-border/60 bg-card/60 p-5 shadow-sm transition-colors hover:bg-card"
            >
              <dt class="mt-1 text-xs text-muted-foreground">{metric.label}</dt>
              <dd class="text-3xl font-bold text-primary">{metric.value}</dd>
            </div>
          ))}
      </dl>
    </div>
  </div>
</section>
