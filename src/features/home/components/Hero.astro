---
import { ArrowDown, ArrowRight } from '@mailflow/ui/icons'

import AmbientOrbit from './AmbientOrbit.astro'
---

<section class="flow-hero" aria-labelledby="hero-title">
  <AmbientOrbit />
  <div class="flow-hero-content">
    <p class="flow-eyebrow"><span class="flow-status"></span> A little clarity goes a long way</p>
    <h1 id="hero-title">Less noise. <br><span>More flow.</span></h1>
    <p class="flow-hero-description">
      A focused place for your email.<br>Find the conversation. Make space for the next thought.
    </p>
    <div class="flow-actions">
      <a href="/signup" class="flow-button"
        >Create your account <ArrowRight aria-hidden="true" size={18} /></a
      >
      <a href="#workspace-preview" class="flow-text-link"
        >Explore the workspace <ArrowDown aria-hidden="true" size={16} /></a
      >
    </div>
  </div>
  <div class="flow-hero-note" aria-hidden="true">
    <span>FROM SCATTERED</span><span class="flow-note-line"></span><span>TO FOCUSED</span>
  </div>
  <a class="flow-scroll-cue" href="#features"
    ><span>Follow the flow</span><ArrowDown aria-hidden="true" size={16} /></a
  >
  <div class="flow-hero-index" aria-hidden="true">
    01 — 03<br><span>A clearer way through</span>
  </div>
</section>
