---
import { ArrowRight } from '@mailflow/ui/icons'

const steps = [
  {
    number: '01',
    title: 'Create your account',
    text: 'Start with your name, email, and password.',
  },
  {
    number: '02',
    title: 'Verify your email',
    text: 'Enter the verification code sent to your inbox.',
  },
  {
    number: '03',
    title: 'Enter your workspace',
    text: 'Sign in to explore MailFlow at your own pace.',
  },
]
---

<section id="how-it-works" class="flow-onboarding flow-container" data-section-motion="onboarding">
  <div class="flow-section-heading" data-onboarding-heading>
    <p class="flow-eyebrow">A simple beginning</p>
    <h2>Your next chapter.<br><span>Three small steps.</span></h2>
  </div>
  <div class="flow-steps" data-onboarding-steps>
    <span class="flow-step-track" aria-hidden="true"><span data-step-progress></span></span>
    {steps.map((step, index) => (
      <article data-onboarding-step={index + 1}>
        <span class="flow-step-number">{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </article>
    ))}
  </div>
  <a class="flow-text-link" href="/signup"
    >Get started <ArrowRight size={16} aria-hidden="true" /></a
  >
</section>
