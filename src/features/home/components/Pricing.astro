---
import { Button } from '@mailflow/ui/components'
import { Check } from '@mailflow/ui/icons'

import { plans } from '../constants/plans'
---

<section class="px-4 py-24 md:px-6" id="pricing">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">Simple pricing</h2>
      <p class="mt-4 text-muted-foreground">Choose the right plan and start your trial today.</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {plans.map((plan) => (
          <article
            class:list={[
              'relative flex h-full flex-col rounded-xl border border-border/60 p-6',
              plan.popular
                ? 'bg-card shadow-xl shadow-primary/10 ring-1 ring-primary/30'
                : 'bg-card/60 shadow-sm',
            ]}
          >
            {plan.popular ? (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold text-primary-foreground shadow transition-colors hover:bg-primary/80">
                Most popular
              </span>
            ) : null}
            <h3 class="text-lg font-semibold text-card-foreground">{plan.name}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{plan.description}</p>
            <div class="mt-5 flex items-baseline gap-1">
              <span class="text-4xl font-bold text-card-foreground">{plan.price}</span>
              {plan.period ? (
                <span class="text-sm text-muted-foreground">{plan.period}</span>
              ) : null}
            </div>
            <ul class="mt-6 flex-1 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm text-card-foreground">
                  <Check aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-success" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <Button
              className="mt-6 w-full disabled:opacity-100"
              disabled={true}
              variant={plan.popular ? 'default' : 'outline'}
            >
              {plan.cta}
            </Button>
          </article>
        ))}
    </div>
  </div>
</section>
