---
import { ArrowRight } from '@mailflow/ui/icons'

import AmbientOrbit from './AmbientOrbit.astro'
---

<section class="flow-final" id="final-cta" aria-labelledby="final-title">
  <AmbientOrbit />
  <p class="flow-eyebrow">Less scattered. More intentional.</p>
  <h2 id="final-title">Make space<br>for <em>what's next.</em></h2>
  <a class="flow-button" href="/signup"
    >Create your account <ArrowRight size={18} aria-hidden="true" /></a
  >
  <p class="flow-final-note">A clearer workspace starts here.</p>
</section>
