---
import CinematicJourney from '@/features/home/components/CinematicJourney.astro'
import Faq from '@/features/home/components/Faq'
import FinalCta from '@/features/home/components/FinalCta.astro'
import Footer from '@/features/home/components/Footer.astro'
import Header from '@/features/home/components/Header'
import Hero from '@/features/home/components/Hero.astro'
import HowItWorks from '@/features/home/components/HowItWorks.astro'
import WorkspacePreview from '@/features/home/components/WorkspacePreview'
import { faqItems } from '@/features/home/constants/faqItems'
import SiteLayout from '@/layouts/SiteLayout.astro'
import '@/styles/cinematic.css'
import '@/styles/sectionMotion.css'
---

<SiteLayout>
  <a class="flow-skip" href="#main">Skip to content</a>
  <div class="flow-page">
    <Header client:load />
    <main id="main" tabindex="-1">
      <Hero />
      <CinematicJourney />
      <div class="flow-preview-section" data-section-motion="preview">
        <div class="flow-section-heading flow-container" data-preview-heading>
          <p class="flow-eyebrow">The view from here</p>
          <h2>A little less noise.<br><span>A lot more room.</span></h2>
          <p>
            Try a search. Open a message. Put a thought into words.<br>This interactive preview uses
            sample messages.
          </p>
        </div>
        <div class="flow-preview-stage" data-preview-frame>
          <WorkspacePreview client:visible />
        </div>
      </div>
      <HowItWorks />
      <Faq client:load />
      <noscript>
        <section class="flow-container flow-static-faq" aria-label="FAQ answers">
          {faqItems.map((item) => <div><h3>{item.question}</h3><p>{item.answer}</p></div>)}
        </section>
      </noscript>
      <FinalCta />
    </main>
    <Footer />
  </div>
</SiteLayout>

<script>
const motionRoots = [...document.querySelectorAll<HTMLElement>('[data-section-motion]')]
const pendingRoots = new Set(motionRoots)
const controllers = new Set<() => void>()
const preview = document.querySelector<HTMLElement>('[data-section-motion="preview"]')
const previewFrame = preview?.querySelector<HTMLElement>('[data-preview-frame]')
let observer: IntersectionObserver | undefined
let disposed = false
let suspended = false

function settlePreview() {
  if (preview) preview.dataset.previewSettled = 'true'
}

function observePendingRoots() {
  if (disposed || !pendingRoots.size || typeof IntersectionObserver === 'undefined') return
  const watcher = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        const root = entry.target as HTMLElement
        watcher.unobserve(root)
        pendingRoots.delete(root)
        void import('../features/home/motion/sectionMotion')
          .then(({ initSectionMotion }) => {
            if (disposed || !root.isConnected) return
            if (suspended) {
              pendingRoots.add(root)
              return
            }
            controllers.add(initSectionMotion(root))
          })
          .catch(() => {
            // The static sections remain readable if the optional motion engine fails to load.
          })
      }
      if (!pendingRoots.size) {
        watcher.disconnect()
        if (observer === watcher) observer = undefined
      }
    },
    { rootMargin: '100px 0px' },
  )
  observer = watcher
  for (const root of pendingRoots) watcher.observe(root)
}

function pageHide(event: PageTransitionEvent) {
  observer?.disconnect()
  observer = undefined
  suspended = event.persisted
  if (event.persisted) return

  disposed = true
  for (const dispose of controllers) dispose()
  controllers.clear()
  preview?.removeEventListener('focusin', settlePreview)
  previewFrame?.removeEventListener('pointerenter', settlePreview)
  previewFrame?.removeEventListener('pointerdown', settlePreview)
  window.removeEventListener('pagehide', pageHide)
  window.removeEventListener('pageshow', pageShow)
}

function pageShow(event: PageTransitionEvent) {
  if (!event.persisted || disposed) return
  suspended = false
  observePendingRoots()
}

preview?.addEventListener('focusin', settlePreview)
previewFrame?.addEventListener('pointerenter', settlePreview)
previewFrame?.addEventListener('pointerdown', settlePreview, { passive: true })
window.addEventListener('pagehide', pageHide)
window.addEventListener('pageshow', pageShow)
observePendingRoots()
</script>
