---
import { PUBLIC_WORKSPACE_BASE_ORIGIN } from 'astro:env/client'
import WorkspaceSignInForm from '@/features/auth/components/WorkspaceSignInForm'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { signUpPath } from '@/shared/config/routes'
---

<SiteLayout
  title="Sign in to MailFlow AI"
  description="Go to your MailFlow AI workspace to sign in."
  noindex
>
  <main
    class="relative grid min-h-screen place-items-center overflow-hidden bg-background px-4 py-16"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div
        class="absolute -top-1/4 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
      ></div>
      <div
        class="absolute bottom-0 -left-1/4 h-[400px] w-[400px] rounded-full bg-indigo-500/10 blur-3xl"
      ></div>
    </div>

    <section
      aria-labelledby="sign-in-heading"
      class="relative w-full max-w-md rounded-2xl border border-border/60 bg-card/80 p-6 shadow-xl shadow-primary/10 backdrop-blur md:p-8"
    >
      <a class="text-sm font-medium text-primary underline-offset-4 hover:underline" href="/">
        ← Back to MailFlow
      </a>
      <h1 class="mt-8 text-3xl font-bold tracking-tight text-card-foreground" id="sign-in-heading">
        Which workspace?
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Enter your workspace subdomain to continue to its sign-in page.
      </p>

      <div class="mt-8">
        <WorkspaceSignInForm client:load workspaceBaseOrigin={PUBLIC_WORKSPACE_BASE_ORIGIN} />
      </div>

      <p class="mt-6 text-center text-sm text-muted-foreground">
        New to MailFlow?{' '}
        <a class="font-medium text-primary underline-offset-4 hover:underline" href={signUpPath}>
          Create an account
        </a>
      </p>
    </section>
  </main>
</SiteLayout>
